# Production environment template for the VPS deployment.
#
# On the server: copy this file to `.env` at the REPO ROOT (same directory as
# docker-compose.prod.yml, not inside backend/) — Docker Compose auto-loads a
# root-level `.env` for both its own ${VAR} interpolation and, via `env_file:`,
# as the app/worker containers' runtime environment. Fill in every placeholder
# below with real values; for anything not listed here (mail, PayMongo keys,
# etc.) copy the corresponding line from backend/.env.example.
#
# Generate APP_KEY with: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
# Generate DB_PASSWORD / REDIS_PASSWORD with: openssl rand -base64 32

APP_NAME="JVD Internal Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jvd_erp
DB_USERNAME=jvd_app
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE

QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

FRONTEND_URL=https://yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Mail Configuration (Hostinger Webmail / Gmail / Resend / SendGrid SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=REPLACE_WITH_YOUR_SMTP_PASSWORD
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="JVD Events & Travels Management"

