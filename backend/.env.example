APP_NAME="JVD Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jvd_erp
DB_USERNAME=jvd_app
DB_PASSWORD=password

# Laravel Sanctum — stateful domain for SPA cookie auth
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,187.77.136.42

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 2FA Toggle for Development
REQUIRE_2FA=true

# Payment gateway. Use sk_test_/pk_test_ in staging; never copy live keys to staging.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Bus charter routing. Set GOOGLE_MAPS_API_KEY in production for higher-quality
# exact-address geocoding; the server falls back to Nominatim when it is blank.
GOOGLE_MAPS_API_KEY=
LOCATION_GEOCODER_URL=https://nominatim.openstreetmap.org
ROUTING_API_URL=https://router.project-osrm.org
LOCATION_API_USER_AGENT="JVD-Internal-Management-System/1.0"
JVD_GARAGE_LOCATION="Q24R+FP Caloocan, Metro Manila"
# TRB currently publishes toll matrices for manual verification; no documented live API is available.
TRB_TOLL_RATES_URL=https://trb.gov.ph/index.php
TOLL_MATRIX_SOURCE_URL=https://toll.ph/matrix
TOLLGURU_API_KEY=
TOLLGURU_BASE_URL=https://apis.tollguru.com/toll/v2
TOLLGURU_MAP_PROVIDER=here
TOLLGURU_BUS_VEHICLE_TYPE=2AxlesBus

# Official PSA administrative location reference. PSGC does not provide street coordinates.
PSGC_API_TOKEN=
PSGC_BASE_URL=https://classification.psa.gov.ph/psgc
PSGC_VERSION=Q2_2024

# Error monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
